# Copy to .env — runtime config, every value optional (defaults live in the code).
# infra/, ops/, ports/, providers/, engines/ and processors/ are materialized from ../common: edit them there, never here.
#
# APP_ENV=dev                    # dev | local | prod (logger rendering, always on stderr)
# CLI_TOKEN=                     # authenticates a run without `ecli auth login`
# CLI_HISTORY=50                 # runs the undo journal keeps
# DB_PATH=data/app.db            # the local store: projects, credential, journal
