@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix core: <https://example.org/core#> .

core:Person a owl:Class ; rdfs:label "Person" .
core:Policy a owl:Class ; rdfs:label "Policy" .
core:holds a owl:ObjectProperty ; rdfs:domain core:Person ; rdfs:range core:Policy .
