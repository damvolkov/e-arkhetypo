# Copy to .env — runtime config, every value optional (defaults live in the code).
# infra/, ops/ and adapters/ are materialized from ../infra: edit them there, never here.
#
# APP_ENV=dev                    # dev | local | prod (logger rendering)
# APP_HOST=127.0.0.1
# APP_PORT=8000
# CRYPTO__SECRET=                # required at runtime: crypto master root (Crypto.generate_keys())
# ALLOW_ORIGINS=["*"]            # JSON lists decode from env
# ALLOW_METHODS=["GET","POST","PATCH","DELETE"]
# REDIS_URL=redis://localhost:6379/0
# DB_PATH=data/app.db
# HTTP_BASE_URL=https://httpbin.org
# HTTP_TIMEOUT=10                # seconds, decoded to timedelta
# PING_TIMEOUT=PT2S              # ISO 8601 duration: one adapter's ping, at startup and on GET /ready
# OTEL_ENDPOINT=                 # OTLP/HTTP collector base, e.g. http://localhost:4318 (empty: spans minted, not exported)
# OTEL_ATTRIBUTES={}            # extra resource attributes, JSON — e.g. {"openinference.project.name": "e-graph"} for Phoenix
# OTEL_SERVICE=e-graph
# OTEL_PROTOCOL=http             # http | grpc (grpc: host:port, http:// = plaintext)
# OTEL_HEADERS={}                # export headers, JSON, secret — e.g. {"api_key": "..."} for a remote collector
# OTEL_TIMEOUT=PT10S             # per-export deadline; also bounds shutdown against a dead collector
# OTEL_FLUSH=PT5S                # batch interval — PT1S to watch traces land live
# OTEL_SAMPLE=1.0                # share of traces kept, 0..1, parent-based
# DOCS_PATH=/docs                # OpenAPI pages root (first renderer served at the root itself)
# DOCS_ALIASES=["/schema"]       # extra roots answering 307 to the same subpath under DOCS_PATH
# DOCS_RENDERERS=["swagger","redoc","elements","rapidoc"]  # also: scalar
#
# ##### AGENT — every value optional; a missing endpoint or key fails the call that needs it, never the boot #####
# Tiers are sub-settings (HIGH / MEDIUM / LOW), field by field — or whole as JSON: AGENT_HIGH={"provider": ..., "model": ...}
# AGENT_MEDIUM__PROVIDER=vllm     # one of the 52 provider ids, or custom — validated at load
# AGENT_MEDIUM__MODEL=gemma4-26b-a4b # required once the tier is declared
# AGENT_MEDIUM__API_BASE=http://localhost:45100/v1   # optional: the provider's own base variable otherwise
# AGENT_MEDIUM__API_KEY=          # optional: the provider's own key variable, or a dummy for local servers
# AGENT_MEDIUM__OPTIONS={}        # provider client options, JSON
# AGENT_HIGH__PROVIDER=  AGENT_HIGH__MODEL=  ·  AGENT_LOW__PROVIDER=  AGENT_LOW__MODEL=
# AGENT_RETRIES=2                # validation retries before an OutputError
# AGENT_TIMEOUT=PT60S            # per provider call
# Per provider, its own standard variables: key resolves run arg → endpoint → these → a dummy for local servers.
# VLLM_API_KEY=                  # VLLM_API_BASE=      (also: OLLAMA_API_KEY / OLLAMA_HOST, LM_STUDIO_*, LLAMACPP_*, LLAMAFILE_*)
# OPENAI_API_KEY=                # OPENAI_BASE_URL=    (or OPENAI_API_BASE)
# ANTHROPIC_API_KEY=             # ANTHROPIC_BASE_URL=
# GEMINI_API_KEY=                # or GOOGLE_API_KEY; GOOGLE_GEMINI_BASE_URL=
# CUSTOM_API_KEY=                # CUSTOM_API_BASE=    any OpenAI-compatible server (provider "custom", base required)
# The full table (52 providers) lives in infra/config/agent.py, PROVIDERS.
#
# ##### DOCLING — docling-serve, the document conversion service (adapters/docling, read by processors/doc) #####
# DOCLING_URL=http://localhost:45800
# DOCLING_TIMEOUT=PT60S          # each HTTP call
# DOCLING_DEADLINE=PT15M         # one whole conversion, status polls included
# DOCLING_POLL=PT1S              # pause between status polls of a running conversion
# DOCLING_FORMATS=["md","json"]  # md | json | html | text | doctags
# DOCLING_IMAGES=embedded        # placeholder | embedded | referenced
# DOCLING_IMAGES_SCALE=2.0
# DOCLING_TABLES=accurate        # fast | accurate (TableFormer)
# DOCLING_OCR=true   DOCLING_FORCE_OCR=false   DOCLING_OCR_ENGINE=auto   DOCLING_OCR_LANG=["en"]
# DOCLING_BACKEND=docling_parse  # docling_parse | pypdfium2
# DOCLING_FORMULAS=false  DOCLING_PICTURES=false  DOCLING_CHARTS=false  DOCLING_CODE=false   # enrichment models
# DOCLING_PAGE_TIMEOUT=          # the server's own per-document deadline (unset: none)
#
# ##### DOC — the hybrid document processor (processors/doc): which engine reads which page #####
# DOC_MODE=hybrid                # lite (liteparse only) | deep (docling only) | hybrid (by page signals)
# DOC_ROUTE=["table","graphics","scanned","images"]   # signals that send a page to docling (also: columns)
# DOC_GAP=1                      # routed pages this close merge into one request (a request ~1.8 s, a page ~1.7 s)
# DOC_SPAN=64                    # most pages per docling request
# DOC_CONCURRENCY=2              # docling requests in flight (docling-serve CPU: x1.35 at 2, nothing more at 4)
# DOC_TABLES=accurate            # TableFormer on routed pages: accurate (= docling) | fast (-40% time, ~96% rows)
# DOC_OCR=false  DOC_TESSDATA=  DOC_OCR_LANGUAGE=eng   # liteparse's own Tesseract (lite mode / docling down)
# DOC_WORKERS=0                  # liteparse page workers (0: its default)
#
# ##### DARTS — the orchestrator (logic/orchestrator): how much of a section runs at once, how semantic specs fuse #####
# DARTS_CONCURRENCY=8            # deterministic specs of one step in flight
# DARTS_CALLS=4                  # fused agent calls of one step in flight
# DARTS_FUSION_SPECS=8           # most specs one fused call answers
# DARTS_FUSION_TOKENS=8000       # most estimated tokens one fused call carries (brief, wiki, examples, material, schema)
# DARTS_TIMEOUT=PT120S           # a spec's deadline when its own `timeout` is unset
