# generated by `make common` from ../common — edit the source there, never here
src/e_graph/infra/*
# infra/config and infra/settings.py are shared homes: common's clusters stay ignored; a project tracks its own with
# `!src/e_graph/infra/settings.py` and `!src/e_graph/infra/config/<own>.py` (materialize never writes over a tracked file there)
!src/e_graph/infra/config/
src/e_graph/infra/config/*
src/e_graph/ops/
src/e_graph/ports/
src/e_graph/providers/
src/e_graph/engines/
src/e_graph/processors/
.venv/
.env
# materialized from ../common — run `make common`; do not edit or commit these
prek.toml
.gitattributes
.python-version
.github/dependabot.yml
.github/CODEOWNERS
site/
data/
data
src/e_graph/ui/node_modules/
# generated by `make bundle` — the canvas the app serves at /
src/e_graph/ui/dist/
src/e_graph/ui/tsconfig.tsbuildinfo

# agent plans (persona: Plans) — working state, never committed
.plans/
# the environment's secrets (`secrets/<APP_ENV>/<var>`); anchored without the slash, so a worktree's link is ignored too
/secrets
