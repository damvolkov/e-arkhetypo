# stack/agent/hermes — copy to .env. Host side only: Hermes' secrets (API keys, tokens) live in HERMES_SECRETS_DIR/.env,
# its managed layer (/etc/hermes); <vault>/hermes/.env keeps only the non-secret settings the e-nous render writes.
HOST_HOME=/home/me
PUID=1000
PGID=1000
# VAULT_DIR=/home/me/.config/memory          # the vault: wiki · persona · brain · inbox · workflow · hermes
# HERMES_SECRETS_DIR=/home/me/.config/secrets/hermes   # .env with the keys, mode 600
