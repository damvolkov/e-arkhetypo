# stack/agent/openhuman — copy to .env (0600). The host side: whose files the core runs as, where they live.
HOST_USER=me
HOST_HOME=/home/me
PUID=1000
PGID=1000
# VAULT_DIR=/home/me/.config/memory          # the vault (Obsidian + Syncthing): wiki · persona · brain · inbox · workflow · openhuman
OPENHUMAN_CORE_TOKEN=                        # openssl rand -hex 32 — every RPC carries it; the UI seeds it on loopback
# OPENHUMAN_TAG=demian                       # the images build.sh tagged
# OPENHUMAN_CORE_PORT=7788
# OPENHUMAN_UI_PORT=1420

# mem/cortexdb (included): the core's memory engine and the mirror into the vault
CORTEX_API_KEY=                              # openssl rand -hex 32
CORTEXDB_VAULT_DIR=/home/me/.config/memory
CORTEXDB_MIRROR_DIR=/home/me/.config/memory/brain
CORTEXDB_MIRROR_SOURCES=kb_workflow=workflow,kb_wiki=wiki,src_vault_notes=inbox/docs
