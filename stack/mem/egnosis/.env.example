# stack/mem/egnosis — copy to .env. Host side only: the service's secrets live in EGNOSIS_ENV_FILE.
HOST_HOME=/home/me
PUID=1000
PGID=1000
EGNOSIS_ENV_FILE=/home/me/.config/secrets/gnosis/env
# EGNOSIS_TAG=latest
# EGNOSIS_DATA_DIR=../data/egnosis          # drive mirrors and caches
# EGNOSIS_CONFIG_DIR=../config/egnosis      # collections, budgets, ontologies of the deployed version
