[Unit]
Description=e-gnosis via Docker Compose — long-term memory API + MCP (host loopback :45200)
After=network-online.target docker.service paradedb.service embed.service reranker.service gliner.service docling.service vllm.service
Wants=network-online.target paradedb.service embed.service reranker.service gliner.service docling.service vllm.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/.config/compose/egnosis
ExecStart=/usr/bin/docker compose up -d --wait --remove-orphans
ExecStop=/usr/bin/docker compose stop
ExecReload=/usr/bin/docker compose up -d --wait --remove-orphans
Restart=on-failure
RestartSec=30s
TimeoutStartSec=180
TimeoutStopSec=40

[Install]
WantedBy=default.target
