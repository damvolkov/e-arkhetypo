#!/usr/bin/env bash
# jsoncrack <file|-> — put a JSON/YAML/XML/CSV document in JSON Crack's drop folder and open it in the editor.
set -euo pipefail
DATA="${JSONCRACK_DATA:-$HOME/.config/memory/workflow/jsoncrack}"
BASE="${JSONCRACK_URL:-http://127.0.0.1:45840}"
src="${1:--}"
mkdir -p "$DATA"
ext="${src##*.}"; [[ "$src" == - || "$ext" == "$src" ]] && ext=json
tmp="$(mktemp "$DATA/.in-XXXXXX")"
cat -- "$src" >"$tmp"
name="$(sha256sum "$tmp" | cut -c1-12).$ext"
chmod 644 "$tmp"
mv -f "$tmp" "$DATA/$name"
url="$BASE/editor?json=$BASE/data/$name"
printf '%s\n' "$url"
[[ -t 1 ]] && command -v xdg-open >/dev/null && xdg-open "$url" >/dev/null 2>&1 &
