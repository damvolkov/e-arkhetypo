[Unit]
Description=JSON Crack via Docker Compose — data formats as graphs (loopback :45840)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/.config/compose/jsoncrack
ExecStart=/usr/bin/docker compose up -d --wait --remove-orphans
ExecStop=/usr/bin/docker compose stop
ExecReload=/usr/bin/docker compose up -d --wait --remove-orphans
Restart=on-failure
RestartSec=30s
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
