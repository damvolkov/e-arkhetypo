# stack/tools/organon — copy to .env. Host side only: the service's secrets live in ORGANON_ENV_FILE.
HOST_HOME=/home/me
PUID=1000
PGID=1000
ORGANON_ENV_FILE=/home/me/.config/secrets/organon/env
# ORGANON_PKI_DIR=/home/me/.config/secrets/pki      # the signing certificate(s), read-only at /run/secrets/pki
# ORGANON_TAG=latest
# ORGANON_DATA_DIR=../data/eorganon         # one subtree per section: doc/ image/ tekton/ … (models, cache, ledger)
# ORGANON_PROFILES=./profiles.yaml          # the tekton bridge's permission book
