# stack/tools/stirling — copy to .env. El 8080 upstream choca con llamacpp/searxng/openwebui:
# en el host propio, bloque de tools 458xx (docling 45800, playwright 45810, pipelines 45820).
STIRLING_PORT=45830

# Admin del primer arranque (evita el admin/stirling con cambio de password forzado)
STIRLING_ADMIN_USER=admin
STIRLING_ADMIN_PASSWORD=change-me-1

# Clave global unica para REST y MCP (X-API-KEY); vacia = solo claves de usuario
STIRLING_API_KEY=change-me-2

# LLM -> slot OpenAI-compatible del stack (strata|vllm); el alias que sirve es demian-model
LLM_BASE_URL=http://llm:8000/v1
LLM_API_KEY=local-dev
LLM_SMART_MODEL=demian-model
LLM_FAST_MODEL=demian-model

# Embeddings -> llm/embed (TEI, OpenAI-compatible en /v1); el modelo que sirve embed
EMBEDDING_BASE_URL=http://embed:80/v1
EMBEDDING_API_KEY=local-dev
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Documento store del motor -> pgvector sobre rdb/postgres.
# Requiere la BD con la extension creada (una vez):
#   docker exec postgres psql -U postgres -c "CREATE DATABASE stirling_docs"
#   docker exec postgres psql -U postgres -d stirling_docs -c "CREATE EXTENSION vector"
STIRLING_BACKEND=pgvector
STIRLING_PGVECTOR_DSN=postgresql://postgres:postgres@postgres:5432/stirling_docs
# STIRLING_BACKEND=sqlite                                # alternativa: store embebido, sin dependencias
# STIRLING_PGVECTOR_DSN=
