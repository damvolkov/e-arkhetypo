[Unit]
Description=ccam via Docker Compose — Claude Code Agent Monitor, sesiones y subagentes (host loopback :4820)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/damien/.config/compose/ccam
ExecStart=/usr/bin/docker compose up -d --wait --remove-orphans
ExecStop=/usr/bin/docker compose stop
ExecReload=/usr/bin/docker compose up -d --wait --remove-orphans
Restart=on-failure
RestartSec=30s
TimeoutStartSec=300
TimeoutStopSec=40

[Install]
WantedBy=default.target
